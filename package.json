{
  "name": "dsh-plugin-streamnest",
  "version": "0.1.1",
  "description": "拾流：解析音视频链接，选择画质并保存到本机；页面与 Agent 共用同一下载队列。",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "streamnest",
    "media-downloader",
    "yt-dlp",
    "ffmpeg"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./packages/harness/locale/*.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/apps/api/src/runtime/assets.json",
    "lib/THIRD_PARTY_LICENSES.txt",
    "assets/logo.svg",
    "assets/reference-projects.json",
    "assets/screenshots/deepseek-harness-installed.png",
    "licenses/*.LICENSE",
    "packages/harness/cordis.patch.yml",
    "packages/harness/locale/*.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./packages/harness/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm run dev:server\" \"pnpm run dev:web\"",
    "dev:server": "pnpm --filter @streamnest/api run start:dev",
    "dev:web": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p apps/api/tsconfig.build.json && tsc -p tsconfig.scripts.json",
    "build:api": "pnpm --filter @streamnest/api run build",
    "build": "pnpm run build:api && node packages/harness/scripts/build.mjs && node --experimental-strip-types scripts/check-package.ts",
    "format": "prettier --write apps packages scripts assets *.json *.md *.mjs *.yaml",
    "format:check": "prettier --check apps packages scripts assets *.json *.md *.mjs *.yaml",
    "lint": "eslint apps packages scripts",
    "test": "tsc -p tsconfig.server.json && vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "verify": "pnpm check && pnpm build && pnpm test",
    "prepack": "pnpm verify",
    "release": "node --experimental-strip-types scripts/release.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^5.1.0",
    "http-proxy-agent": "9.1.0",
    "https-proxy-agent": "9.1.0",
    "puppeteer-core": "25.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socks-proxy-agent": "10.1.0",
    "yauzl": "3.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.3",
    "@eslint/js": "^9.39.0",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@shikijs/langs": "^4.3.1",
    "@types/express": "^5.0.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "anser": "^2.3.5",
    "clsx": "^2.0.0",
    "concurrently": "^9.2.0",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "immer": "^10.2.0",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "prettier": "^3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "5.7.0",
    "shiki": "^4.3.1",
    "simple-icons": "16.31.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4",
    "vitest": "^4.0.0",
    "yazl": "3.3.1",
    "zustand": "^4.4.7"
  }
}
